# {{ ansible_managed }}
[Unit]
Description=nftables host firewall
Documentation=man:nft(8)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target fail2ban.service docker.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f {{ firewall_nft_file }}
ExecReload=/usr/sbin/nft -f {{ firewall_nft_file }}

[Install]
WantedBy=sysinit.target
